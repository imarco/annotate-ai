{
  "name": "annotate-ai",
  "version": "1.2.0",
  "description": "A self-hosted visual review layer with SQLite comments, threads and images.",
  "private": true,
  "main": "annotate.js",
  "unpkg": "annotate.js",
  "jsdelivr": "annotate.js",
  "files": [
    "annotate.js",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node scripts/build-embed.mjs",
    "serve": "bun server/index.ts",
    "project:add": "bun server/cli.ts create-project",
    "start": "bun server/index.ts",
    "demo": "bun server/index.ts",
    "pages:build": "rm -rf _site && mkdir -p _site && cp index.html annotate.js logo.png og-image.png .nojekyll CNAME LICENSE README.md package.json _site/ && cp -R examples _site/examples",
    "deploy:pages": "npm run pages:build",
    "publish:npm": "npm publish --access public",
    "test": "bun test tests/server.test.ts",
    "test:legacy": "playwright test tests/annotate.spec.js",
    "test:chromium": "playwright test --project=chromium",
    "test:mobile": "playwright test --project=mobile-chrome --project=mobile-safari",
    "test:report": "playwright show-report"
  },
  "keywords": [
    "annotation",
    "comments",
    "review",
    "feedback",
    "highlight",
    "markup",
    "proofing",
    "sqlite",
    "self-hosted",
    "vanilla-js"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/imarco/annotate-ai.git"
  },
  "homepage": "https://github.com/imarco/annotate-ai",
  "bugs": {
    "url": "https://github.com/imarco/annotate-ai/issues"
  },
  "directories": {
    "example": "examples"
  },
  "author": "Akash Goswami",
  "devDependencies": {
    "@playwright/test": "^1.61.0",
    "esbuild": "^0.28.2"
  },
  "dependencies": {
    "@uppy/core": "^6.1.0",
    "@uppy/dashboard": "^6.0.0",
    "dompurify": "^3.4.16",
    "emoji-picker-element": "^1.29.1",
    "emoji-picker-element-data": "^1.8.0",
    "marked": "^18.0.14"
  }
}
